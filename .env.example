# Create a Telegram bot with @BotFather and copy its token and username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Add one or more AI provider keys. Providers are tried in this order.
AI_PROVIDER_ORDER=gemini,groq
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.7-flash,gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

DATABASE_PATH=objectlens.sqlite3
MAX_UPLOAD_BYTES=10485760
LINK_CODE_TTL_MINUTES=10
SESSION_TTL_DAYS=30
SUMMARY_DELIVERY=telegram
